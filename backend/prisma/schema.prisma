generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Canal {
  id               String   @id @default(uuid())
  youtubeChannelId String   @unique
  nome             String
  descricao        String?
  thumbnailUrl     String?
  criadoEm         DateTime @default(now())
  trilhas          Trilha[]
  videos           Video[]

  @@map("canais")
}

model Video {
  id              String        @id @default(uuid())
  youtubeVideoId  String        @unique
  canalId         String
  titulo          String
  descricao       String?
  thumbnailUrl    String?
  duracaoSegundos Int?
  tags            String[]
  publicadoEm     DateTime?
  isCurated       Boolean       @default(false)
  cachedEm        DateTime      @default(now())
  cacheExpiraEm   DateTime?
  resumoIA        String?
  trilhas         TrilhaVideo[]
  canal           Canal         @relation(fields: [canalId], references: [id])

  @@map("videos")
}

model Categoria {
  id        String   @id @default(uuid())
  nome      String   @unique
  descricao String?
  criadaEm  DateTime @default(now())
  trilhas   Trilha[]

  @@map("categorias")
}

model Trilha {
  id                   String        @id @default(uuid())
  categoriaId          String
  canalId              String?
  youtubePlaylistId    String?       @unique
  titulo               String
  slug                 String        @unique
  descricao            String?
  nivel                String?
  thumbnailUrl         String?
  duracaoTotalSegundos Int?
  destaque             Boolean       @default(false)
  isCurated            Boolean       @default(true)
  ativa                Boolean       @default(true)
  criadaEm             DateTime      @default(now())
  ordem                Int           @default(0)
  videos               TrilhaVideo[]
  canal                Canal?        @relation(fields: [canalId], references: [id])
  categoria            Categoria     @relation(fields: [categoriaId], references: [id])
  materiais            Material[]

  @@map("trilhas")
}

model TrilhaVideo {
  trilhaId String
  videoId  String
  ordem    Int
  trilha   Trilha @relation(fields: [trilhaId], references: [id])
  video    Video  @relation(fields: [videoId], references: [id])

  @@id([trilhaId, videoId])
  @@map("trilha_videos")
}

model BuscaCache {
  id           String    @id @default(uuid())
  termo        String
  categoria    String?
  buscadoEm    DateTime  @default(now())
  expiraEm     DateTime?
  resultadoIds String[]

  @@unique([termo, categoria])
  @@map("buscas_cache")
}

model Material {
  id         Int      @id @default(autoincrement())
  nome       String
  descricao  String?
  arquivoUrl String
  tipo       String
  tamanho    Int?
  trilhaId   String
  criadoEm   DateTime @default(now())

  trilha Trilha @relation(fields: [trilhaId], references: [id], onDelete: Cascade)

  @@map("materiais")
}
